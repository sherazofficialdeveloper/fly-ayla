# Fly Ayla Backend Environment Variables
PORT=3000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://localhost:27017/fly-ayla

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:3000

# Integrations (Optional / Production)
JETFUELX_API_KEY=
JETFUELX_API_URL=https://api.jetfuelx.com/v1
PAYLA_FORENSIC_API_KEY=
PAYLA_FORENSIC_API_URL=https://api.paylaforensic.com/v1
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fly Ayla Aviation" <charter@flyayla.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
